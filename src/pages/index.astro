---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
import ProjectCard from "../components/ProjectCard.astro";

const title = `${site.name} — Home`;
const description = site.seo.description;

// ASSUMPTION:
// projects[] is ordered oldest → newest
// If wrong, swap to: projects.slice(0, 2)
const latest = projects.slice(0, 2);

---

<Base title={title} description={description}>
  <!-- HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="heroLeft">
      <img
        src="/me.JPG"
        alt={`${site.name} portrait`}
        class="portrait"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="heroRight">
      <h1 class="headline">
        I’m {site.name}, a Microengineering student.
      </h1>

      <p class="lead">
        2nd year BSc — specializing in electronics, with hands-on experience in
        manufacturing, automation, and prototyping.
      </p>

      <p class="lead">
        Seeking an industrial or R&D internship where I can contribute practical
        engineering skills and systems-level problem solving.
      </p>

      <div class="ctaRow">
        <a class="btn" href="/projects">Projects</a>
        <a class="btn" href="/about">About</a>
        <a class="btn" href="/contact">Contact</a>
      </div>
    </div>
  </section>

  <!-- LATEST PROJECTS -->
  <section aria-label="Latest projects" class="latest">
    <div class="latestHead">
      <h2>Latest projects</h2>
      <a href="/projects">See all →</a>
    </div>

    <section class="projectsGrid" aria-label="Project preview">
      {latest.map((p) => (
        <ProjectCard project={p} />
      ))}
    </section>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
    padding: 3.5rem 0 2.5rem 0;
  }

  .heroLeft {
    display: flex;
    justify-content: center;
  }

  .portrait {
    width: min(460px, 90%);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 28px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
  }

  .heroRight {
    max-width: 640px;
  }

  .headline {
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    line-height: 1.05;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 0.85rem 0;
    opacity: 0.92;
  }

  .ctaRow {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid rgba(0, 0, 0, 0.15);
    font-weight: 600;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .latest {
    margin-top: 3rem;
  }

  .latestHead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding-top: 2.25rem;
    }

    .portrait {
      width: min(380px, 100%);
    }
  }
</style>
